<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <shape name="card_background">
        <solid android:color="@color/card_background" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/divider" />
    </shape>

    <shape name="status_running">
        <solid android:color="@color/status_running" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="status_stopped">
        <solid android:color="@color/status_stopped" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="status_paused">
        <solid android:color="@color/status_paused" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="status_creating">
        <solid android:color="@color/status_creating" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="status_error">
        <solid android:color="@color/status_error" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="status_idle">
        <solid android:color="@color/status_idle" />
        <corners android:radius="12dp" />
    </shape>

    <shape name="rounded_corner">
        <solid android:color="@color/white" />
        <corners android:radius="16dp" />
    </shape>
</resources>
